---
import Doc from '../../layouts/Doc.astro';
import { getCollection } from 'astro:content';
const items = (await getCollection('knowledge')).filter(e => !e.data.draft)
  .sort((a,b) => a.data.title.localeCompare(b.data.title, 'ko'));
---
<Doc title="Knowledge Base — Hyunbin Choi" description="Concepts I keep coming back to, rewritten in my own words.">
  <h1 class="h-page rv">Knowledge Base</h1>
  <p class="sub rv rv-1" style="margin-top:12px">
    Concepts I keep coming back to. Rewritten in my own words, including where I got them wrong first.
  </p>
  <section class="sect">
    {items.length ? (
      <div class="rows">
        {items.map(e => (
          <a class="row" href={`/knowledge/${e.id}/`}>
            <div class="rt"><h3>{e.data.title}</h3></div>
            <p class="rd">{e.data.summary}</p>
            <div class="rmeta">{e.data.tags.map(t => <span class="badge">{t}</span>)}</div>
          </a>
        ))}
      </div>
    ) : <div class="blank">Nothing here yet.</div>}
  </section>
</Doc>
